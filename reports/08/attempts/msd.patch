+// Exact adaptive MSD radix sort. Each nontrivial level consumes eight of
+// the remaining varying key bits; shared prefixes need no separate passes.
+static void SortKeys(uint64_t *keys, uint64_t *scratch, int n)
+{
+    if (n <= 16)
+    {
+        for (int i = 1; i < n; ++i)
+        {
+            uint64_t value = keys[i];
+            int j = i;
+            while (j > 0 && keys[j - 1] > value) { keys[j] = keys[j - 1]; --j; }
+            keys[j] = value;
+        }
+        return;
+    }
+    uint64_t varying = 0;
+    for (int i = 1; i < n; ++i) varying |= keys[i] ^ keys[0];
+    if (varying == 0) return;
+    int highest = 63 - __builtin_clzll(varying);
+    int shift = highest > 7 ? highest - 7 : 0;
+    unsigned counts[256] = {0}, offsets[257];
+    for (int i = 0; i < n; ++i) ++counts[(keys[i] >> shift) & 255];
+    offsets[0] = 0;
+    for (int b = 0; b < 256; ++b)
+    {
+        offsets[b + 1] = offsets[b] + counts[b];
+        counts[b] = offsets[b];
+    }
+    for (int i = 0; i < n; ++i) scratch[counts[(keys[i] >> shift) & 255]++] = keys[i];
+    for (int b = 0; b < 256; ++b)
+    {
+        int count = (int)(offsets[b + 1] - offsets[b]);
+        if (count > 1) SortKeys(scratch + offsets[b], keys + offsets[b], count);
+    }
+    memcpy(keys, scratch, (size_t)n * sizeof(*keys));
+}
